# The environment's fixed values, read by e2e.sh through --env-file. deploy/.env
# is never read: it can hold real provider keys, and nothing of it may reach
# this stack. These are test constants, not secrets; the network is internal.
POSTGRES_PASSWORD=e2e-postgres
LUA_PASSWORD=e2e-lua
ESL_PASSWORD=e2e-esl
AICC_SEED_PASSWORD=e2e-seed
E2E_PASSWORD=e2e-admin-pw
